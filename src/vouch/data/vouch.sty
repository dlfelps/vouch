%% vouch.sty -- every number in the paper, vouched for by the code that produced it.
%%
%% Values are recorded by experiments, rendered by `vouch build` into
%% vouch-values.tex, and cited here by key:
%%
%%   \vouch{key}  \vouch[fmt]{key}  \vouchraw{key}  \vouchclaim{key}{prose}  \vouchtable{key}
%%
%% Options:
%%   provenance=link|tooltip|note|off   how a reader gets from a number to its source
%%       link     (default) each value links to a generated "Value provenance"
%%                appendix; works in every PDF viewer
%%       tooltip  hover text (Acrobat, Firefox; not Chrome/Edge)
%%       note     a sticky-note icon beside each value (most desktop viewers)
%%   tooltip=key|value|full   how much tooltip/note text says (default full)
%%   highlight=off|changed    colour values changed since last acknowledged
%%   final                    camera-ready: no links, notes, colours or appendix;
%%                            unknown/pending keys and false claims are errors
%%   short                    also define \val, \vclaim, \vtable
%%   values=FILE              the generated values file (default vouch-values.tex)
%%
%% \vouchprovenance places the appendix yourself; otherwise it ends the draft.
%% Copied into the paper by `vouch init`; see SPEC.md section 7.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{vouch}[2026/09/18 v0.2 numbers vouched for by code]

\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=vouch,prefix=vouch@opt@}
\DeclareStringOption[link]{provenance}
\DeclareStringOption[full]{tooltip}
\DeclareStringOption[changed]{highlight}
\DeclareStringOption[vouch-values.tex]{values}
\DeclareBoolOption{final}
\DeclareBoolOption{short}
\ProcessKeyvalOptions*

% ---------------------------------------------------------------------------
% switches
% ---------------------------------------------------------------------------
\newif\ifvouch@hl     \vouch@hltrue
\newif\ifvouch@undefined
\newif\ifvouch@nolink          % inside a claim's link or a TOC line: no nested links
\newif\ifvouch@appendixdone
\def\vouch@lvl@off{off}\def\vouch@lvl@key{key}\def\vouch@lvl@value{value}
\edef\vouch@mode{\vouch@opt@provenance}
\ifx\vouch@opt@tooltip\vouch@lvl@off \def\vouch@mode{off}\fi      % tooltip=off: v0.1 spelling
\def\vouch@tmp{off}\ifx\vouch@opt@highlight\vouch@tmp \vouch@hlfalse \fi
\ifvouch@opt@final \def\vouch@mode{off}\vouch@hlfalse \fi
\def\vouch@mode@link{link}
\@tempswafalse
\@for\vouch@tmp:={link,tooltip,note,off}\do{\ifx\vouch@tmp\vouch@mode\@tempswatrue\fi}
\if@tempswa\else
  \PackageWarningNoLine{vouch}{Unknown provenance=\vouch@mode; using link}%
  \def\vouch@mode{link}%
\fi

% Load late, at the end of the preamble: hyperref wants to come last, and a user
% loading xcolor with options after us must not hit an option clash.
\def\vouch@atendpreamble{%
  \@ifundefined{AddToHook}%
    {\RequirePackage{etoolbox}\AtEndPreamble}%
    {\AddToHook{begindocument/before}}}

\def\vouch@needhyperref{%
  \@ifpackageloaded{hyperref}{\let\vouch@hadhyperref\@empty}{}%
  \RequirePackage{hyperref}%
  % hyperref arrived only because of vouch: keep the document's look
  \ifx\vouch@hadhyperref\@undefined \hypersetup{hidelinks}\fi}

\def\vouch@tmp{tooltip}\ifx\vouch@mode\vouch@tmp\def\vouch@usepdfcomment{}\fi
\def\vouch@tmp{note}\ifx\vouch@mode\vouch@tmp\def\vouch@usepdfcomment{}\fi
\ifdefined\vouch@usepdfcomment
  \IfFileExists{pdfcomment.sty}{%
    \vouch@atendpreamble{\vouch@needhyperref\RequirePackage{pdfcomment}}%
  }{%
    \PackageWarningNoLine{vouch}{pdfcomment.sty not found: provenance=\vouch@mode\space
      falls back to link}%
    \def\vouch@mode{link}}
\fi
\ifx\vouch@mode\vouch@mode@link
  \vouch@atendpreamble{\vouch@needhyperref}
\fi
\ifvouch@opt@final\else
  \vouch@atendpreamble{%
    \@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}%
    \providecolor{vouchchanged}{RGB}{204,85,0}%
    \providecolor{vouchvalue}{RGB}{0,70,140}%
    \providecolor{vouchmark}{RGB}{200,0,0}}
\fi

% ---------------------------------------------------------------------------
% the values file writes these
% ---------------------------------------------------------------------------
% \vouch@set{key}{fmt}{rendered}{plain}{tooltip}{changed 0/1}
\long\def\vouch@set#1#2#3#4#5#6{%
  \@namedef{vouch@v@#1@#2}{#3}%
  \@namedef{vouch@p@#1@#2}{#4}%
  \@namedef{vouch@t@#1@#2}{#5}%
  \@namedef{vouch@c@#1@#2}{#6}}
% \vouch@raw{key}{raw number}
\def\vouch@raw#1#2{\@namedef{vouch@r@#1}{#2}}
% \vouch@claim{key}{holds 1/0}{tooltip}{changed 0/1}
\long\def\vouch@claim#1#2#3#4{%
  \@namedef{vouch@cl@#1}{#2}%
  \@namedef{vouch@ct@#1}{#3}%
  \@namedef{vouch@cc@#1}{#4}}
% \vouch@prov{key}{typeset provenance for the appendix}
\long\def\vouch@prov#1#2{\@namedef{vouch@prov@#1}{#2}}
% \vouch@pending{key}{producer command}
\def\vouch@pending#1#2{\@namedef{vouch@pend@#1}{#2}}
% \vouch@table{key}{path}: the trailing space ends the file name for \@@input
\def\vouch@table#1#2{\@namedef{vouch@tab@#1}{#2 }}
% \vouch@state{run}{text}: the run's freshness (depends on the working tree)
\def\vouch@state#1#2{\@namedef{vouch@st@#1}{#2}}
\def\vouch@runstate#1{\ifcsname vouch@st@#1\endcsname\csname vouch@st@#1\endcsname\fi}

\def\vouch@ifdef#1{%
  \ifcsname#1\endcsname\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}

% ---------------------------------------------------------------------------
% markers for things that are not (yet) vouched for
% ---------------------------------------------------------------------------
\def\vouch@mark#1{%
  \ifdefined\textcolor\textcolor{vouchmark}{\textbf{#1}}\else\textbf{#1}\fi}
\def\vouch@unknown#1{%
  \global\vouch@undefinedtrue
  \ifvouch@opt@final
    \PackageError{vouch}{Value `#1' is undefined}{No run recorded this key. Record it, or
      fix the key, then run `vouch build'.}%
  \else
    \PackageWarning{vouch}{Value `#1' undefined}%
  \fi
  \vouch@mark{??\detokenize{#1}}}
\def\vouch@missingfmt#1#2{%
  \global\vouch@undefinedtrue
  \PackageWarning{vouch}{Format `#2' of `#1' was not built; run `vouch build'}%
  \vouch@mark{??\detokenize{#1}[\detokenize{#2}]}}
\def\vouch@pendingmark#1{%
  \global\vouch@undefinedtrue
  \ifvouch@opt@final
    \PackageError{vouch}{Value `#1' is still pending}{Run its producer:
      \csname vouch@pend@#1\endcsname}%
  \else
    \PackageWarning{vouch}{Value `#1' is pending (declared with vouch.expect)}%
  \fi
  \fbox{\scriptsize pending: \detokenize{#1}}}

% ---------------------------------------------------------------------------
% citations, for the appendix: which keys, and on which pages
% ---------------------------------------------------------------------------
% Page numbers go through the aux file, but not through \label: amsmath takes
% \label over inside equation environments.
\newcount\vouch@cites
\def\vouch@citedlist{}
\def\vouch@pageof#1#2{\global\@namedef{vouch@page@#1}{#2}}
\def\vouch@register#1{%
  \global\advance\vouch@cites\@ne
  \ifcsname vouch@pg@#1\endcsname
    \expandafter\xdef\csname vouch@pg@#1\endcsname{\csname vouch@pg@#1\endcsname,\the\vouch@cites}%
  \else
    \expandafter\xdef\csname vouch@pg@#1\endcsname{\the\vouch@cites}%
    \xdef\vouch@citedlist{\unexpanded\expandafter{\vouch@citedlist}\noexpand\vouch@entry{#1}}%
  \fi
  \Hy@raisedlink{\hyper@anchorstart{vouch@a@\the\vouch@cites}\hyper@anchorend}%
  \protected@write\@auxout{}{\string\vouch@pageof{\the\vouch@cites}{\thepage}}}
\AtBeginDocument{%
  \if@filesw\immediate\write\@auxout{\string\providecommand\string\vouch@pageof[2]{}}\fi}

% ---------------------------------------------------------------------------
% presenting a value, per provenance mode
% ---------------------------------------------------------------------------
% tooltip / note text at the chosen level
\def\vouch@tiptext#1#2{%
  \ifx\vouch@opt@tooltip\vouch@lvl@key \detokenize{#1}%
  \else\ifx\vouch@opt@tooltip\vouch@lvl@value
    \detokenize{#1} = \csname vouch@r@#1\endcsname
  \else \csname vouch@t@#1@#2\endcsname \fi\fi}

% \vouch@present@MODE{content}{key}{tooltip text}
\long\def\vouch@present@off#1#2#3{#1}
\long\def\vouch@present@link#1#2#3{%
  \ifvouch@nolink #1\else
    \vouch@register{#2}\hyperlink{vouch.#2}{#1}\fi}
\long\def\vouch@present@tooltip#1#2#3{%
  \ifvouch@nolink #1\else\ifdefined\pdftooltip\pdftooltip{#1}{#3}\else #1\fi\fi}
\long\def\vouch@present@note#1#2#3{%
  #1\ifvouch@nolink\else\ifdefined\pdfcomment\pdfcomment[icon=Comment,author=vouch]{#3}\fi\fi}

\def\vouch@colour#1{% changed-since-acknowledged beats the plain link colour
  \ifdefined\color
    \ifvouch@hl\if1#1\color{vouchchanged}\else\vouch@linkcolour\fi
    \else\vouch@linkcolour\fi
  \fi}
\def\vouch@linkcolour{\ifx\vouch@mode\vouch@mode@link\color{vouchvalue}\fi}

% ---------------------------------------------------------------------------
% \vouch[fmt]{key}
% ---------------------------------------------------------------------------
\DeclareRobustCommand\vouch{\@ifnextchar[\vouch@i{\vouch@i[]}}
\def\vouch@i[#1]#2{\vouch@show{#2}{#1}}
\def\vouch@show#1#2{%
  \vouch@ifdef{vouch@v@#1@#2}%
    {\vouch@emit{#1}{#2}}%
    {\vouch@ifdef{vouch@pend@#1}%
      {\vouch@pendingmark{#1}}%
      {\vouch@ifdef{vouch@v@#1@}%
        {\vouch@missingfmt{#1}{#2}}%
        {\vouch@unknown{#1}}}}}
\def\vouch@emit#1#2{%
  \begingroup
  \ifvouch@nolink\ifx\vouch@mode\vouch@mode@link\vouch@register{#1}\fi\fi
  \csname vouch@present@\vouch@mode\endcsname
    {\vouch@colour{\csname vouch@c@#1@#2\endcsname}\csname vouch@v@#1@#2\endcsname}%
    {#1}{\vouch@tiptext{#1}{#2}}%
  \endgroup}

% ---------------------------------------------------------------------------
% \vouchraw{key}: expandable, for pgfplots / \pgfmathparse / siunitx input
% ---------------------------------------------------------------------------
\def\vouchraw#1{\ifcsname vouch@r@#1\endcsname\csname vouch@r@#1\endcsname\else ??#1\fi}

% ---------------------------------------------------------------------------
% \vouchclaim{key}{prose}
% ---------------------------------------------------------------------------
\DeclareRobustCommand\vouchclaim[2]{%
  \vouch@ifdef{vouch@cl@#1}%
    {\vouch@claimbody{#1}{#2}}%
    {#2\vouch@claimbad{#1}{unknown}}}
\long\def\vouch@claimbody#1#2{%
  \begingroup
  \def\vouch@claimkey{#1}%
  \vouch@colour{\csname vouch@cc@#1\endcsname}%
  \csname vouch@claim@\vouch@mode\endcsname{#1}{#2}%
  \endgroup
  \if0\csname vouch@cl@#1\endcsname\vouch@claimbad{#1}{FALSE}\fi}
\long\def\vouch@claim@off#1#2{#2}
\long\def\vouch@claim@link#1#2{% one link over the whole prose; values inside don't nest links
  \ifvouch@nolink #2\else
    \vouch@register{#1}\vouch@nolinktrue\hyperlink{vouch.#1}{#2}\fi}
\long\def\vouch@claim@note#1#2{%
  #2\ifdefined\pdfcomment\pdfcomment[icon=Comment,author=vouch]{\csname vouch@ct@#1\endcsname}\fi}
% tooltips word by word: a tooltip is an unbreakable box, and prose must still break
\long\def\vouch@claim@tooltip#1#2{\ifdefined\pdftooltip\vouch@words#2 \@nil\else#2\fi}
\long\def\vouch@words#1 #2\@nil{%
  \ifx\relax#1\relax\else
    \in@{\vouch}{#1}% a word that is itself a \vouch keeps its own tooltip
    \ifin@ #1\else
      \pdftooltip{#1}{\csname vouch@ct@\vouch@claimkey\endcsname}\fi
  \fi
  % close the conditional before recursing, so a long claim doesn't nest one \fi per word
  \ifx\relax#2\relax\expandafter\@gobble\else\expandafter\@firstofone\fi
    {\space\vouch@words#2\@nil}}
\def\vouch@claimbad#1#2{%
  \ifvouch@opt@final
    \PackageError{vouch}{Claim `#1' is #2}{`vouch check' explains why.}%
  \else
    \PackageWarning{vouch}{Claim `#1' is #2}%
    \global\vouch@undefinedtrue
    \textsuperscript{\vouch@mark{[claim #2: \detokenize{#1}]}}%
  \fi}

% ---------------------------------------------------------------------------
% \vouchtable{key}: the generated body rows. Expandable on purpose: a table
% rule (\midrule) after \\ inside the file needs \@@input, not \input.
% ---------------------------------------------------------------------------
\def\vouchtable#1{%
  \vouch@ifdef{vouch@tab@#1}%
    {\expandafter\@@input\csname vouch@tab@#1\endcsname}%
    {\vouch@unknown{#1}}}
\providecommand\vouchbest[1]{\ifmmode\mathbf{#1}\else{\bfseries\boldmath#1}\fi}
\providecommand\vouchsecond[1]{\underline{#1}}

% ---------------------------------------------------------------------------
% the provenance appendix (provenance=link)
% ---------------------------------------------------------------------------
\providecommand\vouchprovenancename{Value provenance}
\def\vouch@valueof#1{%
  \vouch@ifdef{vouch@v@#1@}{\csname vouch@v@#1@\endcsname}%
    {\vouch@ifdef{vouch@cl@#1}{claim \if1\csname vouch@cl@#1\endcsname holds\else is FALSE\fi}{}}}
\def\vouch@pages#1{%
  \def\vouch@lastpage{}\def\vouch@sep{cited on p.\,}%
  \edef\vouch@list{\csname vouch@pg@#1\endcsname}%
  \@for\vouch@n:=\vouch@list\do{%
    \ifcsname vouch@page@\vouch@n\endcsname
      \edef\vouch@pg{\csname vouch@page@\vouch@n\endcsname}%
      \ifx\vouch@pg\vouch@lastpage\else
        \vouch@sep\edef\vouch@tmp{\noexpand\hyperlink{vouch@a@\vouch@n}}%
        \vouch@tmp{\vouch@pg}\def\vouch@sep{, }%
        \let\vouch@lastpage\vouch@pg
      \fi
    \fi}%
  \ifx\vouch@lastpage\@empty(page numbers after the next LaTeX run)\fi}
\def\vouch@entry#1{%
  \item\Hy@raisedlink{\hyper@anchorstart{vouch.#1}\hyper@anchorend}%
  \textbf{\texttt{\detokenize{#1}}}\ = \vouch@valueof{#1}\hfill{\footnotesize\vouch@pages{#1}}\par
  \csname vouch@prov@#1\endcsname}
\newcommand\vouchprovenance{%
  \ifx\vouch@mode\vouch@mode@link\ifx\vouch@citedlist\@empty\else
    \global\vouch@appendixdonetrue
    \section*{\vouchprovenancename}%
    {\small\noindent Every number in this draft links here. Each entry names the run that
     recorded it, where, and how; \texttt{vouch check} verifies them against the code.
     Compile with \texttt{\string\usepackage[final]\char`\{vouch\char`\}} to drop this appendix.\par
     \begingroup\vouch@nolinktrue\raggedright   % keys and paths don't hyphenate
     \begin{list}{}{\setlength\leftmargin{0pt}\setlength\itemsep{1.2ex}%
                    \setlength\parsep{0pt}\setlength\itemindent{0pt}}%
       \vouch@citedlist
     \end{list}\endgroup}%
  \fi\fi}
\AtEndDocument{%
  \ifx\vouch@mode\vouch@mode@link\ifvouch@appendixdone\else
    \ifx\vouch@citedlist\@empty\else\clearpage\vouchprovenance\fi
  \fi\fi
  \ifvouch@undefined
    \PackageWarningNoLine{vouch}{There were undefined or pending vouch values.
      Run `vouch build' and recompile}%
  \fi}

% ---------------------------------------------------------------------------
% bookmarks and other PDF strings: plain text, expandably; no links in the TOC
% ---------------------------------------------------------------------------
\def\vouch@pdf#1#{\vouch@pdf@a{#1}}
\def\vouch@pdf@a#1#2{\vouch@pdf@b#1[]\@nil{#2}}
\def\vouch@pdf@b#1[#2]#3\@nil#4{%
  \ifcsname vouch@p@#4@#2\endcsname\csname vouch@p@#4@#2\endcsname\else ??#4\fi}
\long\def\vouch@pdfclaim#1#2{#2}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \pdfstringdefDisableCommands{%
      \let\vouch\vouch@pdf
      \let\vouchclaim\vouch@pdfclaim}}{}%
  % a table-of-contents / list-of-figures line is already a link
  \let\vouch@orig@contentsline\contentsline
  \def\contentsline{\vouch@nolinktrue\vouch@orig@contentsline}}

% ---------------------------------------------------------------------------
% short aliases
% ---------------------------------------------------------------------------
\ifvouch@opt@short
  \@ifundefined{val}{\let\val\vouch}{\PackageWarningNoLine{vouch}{\string\val\space exists; alias not defined}}
  \@ifundefined{vclaim}{\let\vclaim\vouchclaim}{\PackageWarningNoLine{vouch}{\string\vclaim\space exists; alias not defined}}
  \@ifundefined{vtable}{\let\vtable\vouchtable}{\PackageWarningNoLine{vouch}{\string\vtable\space exists; alias not defined}}
\fi

% ---------------------------------------------------------------------------
% the values
% ---------------------------------------------------------------------------
\InputIfFileExists{\vouch@opt@values}{}{%
  \PackageWarningNoLine{vouch}{No values file `\vouch@opt@values'. Run `vouch build'}}

\endinput
